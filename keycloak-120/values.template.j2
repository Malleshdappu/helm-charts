name: keycloak120
dockerImage: mosipid/mosip-artemis-keycloak
dockerTag: 1.2.0.1 
keycloakUser: {{ keycloak120.user }}
keycloakPassword: '' # To be passed directly with helm command
domain: {{ sandbox_domain_name }}
internalDomain: {{ clusters.mz.nodeport_node }} 
keycloakExternalUrl: "https://{{ sandbox_domain_name }}/keycloak120/auth/"  
containerPort: 8080
exportLogs: enabled  # Let filebeat export the logs
servicePort: 80
db:
  name: {{ keycloak120.db.name }}
  host: {{ keycloak120.db.host }}
  port: {{ keycloak120.db.port }}
  user: {{ keycloak120.db.user }}
  password: ''  # Passed from helm directly 
ingress:
   namespace: default
   path: keycloak120

services:
  keycloak:
    podconfig:
      {{ podconfig.keycloak.service | to_nice_yaml(indent=6) | indent(6) }}

probe:
  period: 10 # Seconds
  timeout: 5
  livenessPeriod: 30
  failureThreshold: 15
  startupPeriod: 10
  initialDelaySeconds: 30

