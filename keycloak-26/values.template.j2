name: keycloak26
dockerImage: quay.io/keycloak/keycloak
dockerTag: 26.7.4
keycloakUser: {{ keycloak26.user }}
keycloakPassword: '' # To be passed directly with helm command
domain: {{ sandbox_domain_name }}
internalDomain: {{ clusters.mz.nodeport_node }} 
keycloakExternalUrl: "https://{{ sandbox_domain_name }}/keycloak26/auth/"  
containerPort: 8080
exportLogs: enabled  # Let filebeat export the logs
servicePort: 80
db:
  name: {{ keycloak26.db.name }}
  host: {{ keycloak26.db.host }}
  port: {{ keycloak26.db.port }}
  user: {{ keycloak26.db.user }}
  password: ''  # Passed from helm directly 
ingress:
   namespace: default
   path: keycloak26

keycloak:
  httpEnabled: "true"
  httpRelativePath: "/auth"
  proxyHeaders: "xforwarded"
  hostname: "https://{{ sandbox_domain_name }}/keycloak26/auth"
  healthEnabled: "true"

services:
  keycloak:
    podconfig:
      {{ podconfig.keycloak.service | to_nice_yaml(indent=6) | indent(6) }}

probe:
  period: 10 # Seconds
  timeout: 5
  livenessPeriod: 30
  failureThreshold: 15
  startupPeriod: 10
  initialDelaySeconds: 30

